# ─────────────────────────────────────────────────────────────
# INFOPATH 웹사이트 환경변수
#
# 로컬 개발: 이 파일을 .env.local 로 복사한 뒤 값을 채우십시오.
#   cp .env.example .env.local
#
# 운영(Vercel): Vercel 대시보드 → Settings → Environment Variables 에
#   동일한 키를 등록합니다. .env.local 은 배포되지 않습니다.
#
# ⚠️ .env.local 은 절대 저장소에 커밋하지 마십시오 (.gitignore 처리됨).
# ─────────────────────────────────────────────────────────────

# 사이트 기본 URL — 메타태그·sitemap 생성에 사용
NEXT_PUBLIC_SITE_URL=https://infopath.co.kr

# ── 검색엔진 색인 모드 ───────────────────────────────────────
# public  | 정식 공개. 크롤링 허용 + index,follow
# hidden  | 검색에서 빼는 중. 크롤링은 허용하고 noindex 로 빼라고 지시합니다.
#         | ⚠ 여기서 크롤링을 막으면 크롤러가 noindex 를 읽지 못해 아무것도 빠지지 않습니다.
# blocked | 완전 차단(robots.txt 전체 거부). 검색 결과에서 다 빠진 것을 확인한 뒤에만.
#
# 전환 순서: public → hidden → (색인 소멸 확인) → blocked
# 미설정 시 blocked 입니다 (로컬·프리뷰 배포 보호).
#
# 현재 운영값: hidden — 2026-10-05, INFOLINK 미완성으로 검색에서 내리는 중.
#              경위는 docs/progress.md 「세션 2」 참고.
NEXT_PUBLIC_INDEXING_MODE=hidden

# ── 문의 폼 발송 (Resend) ────────────────────────────────────
# 필수. https://resend.com/api-keys 에서 발급합니다.
# lib/inquiry.ts 에서 사용합니다.
RESEND_API_KEY=

# 선택 — 미설정 시 gepark@infopath.co.kr 로 발송됩니다.
INQUIRY_TO=gepark@infopath.co.kr

# 선택 — 발신 주소.
# Resend에 infopath.co.kr 도메인을 등록하고 DKIM 인증을 마친 뒤에만
# @infopath.co.kr 주소를 쓸 수 있습니다 (docs/deploy.md 4장 참고).
# 미설정 시 Resend 테스트 발신 주소가 사용되며, 계정 소유자에게만 전달됩니다.
INQUIRY_FROM="INFOPATH 문의 <noreply@infopath.co.kr>"
